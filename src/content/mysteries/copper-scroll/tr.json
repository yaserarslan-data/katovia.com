                },
                "\n",
                {
                  "tag": "tr",
                  "attrs": {},
                  "children": [
                    {
                      "tag": "td",
                      "attrs": {},
                      "children": [
                        "“Hazine mutlaka gerçek, çünkü bakıra yazılmış.”"
