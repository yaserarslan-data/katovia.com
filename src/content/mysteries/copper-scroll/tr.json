                      ]
                    },
                    {
                      "tag": "td",
                      "attrs": {},
                      "children": [
                        "Metin yaklaşık bin yıl daha geç bir döneme aittir. Süleyman’la doğrudan bağlantı gösteren kanıt yok."
                      ]
                    }
                  ]
                },
                "\n",
                {
                  "tag": "tr",
                  "attrs": {},
                  "children": [
                    {
                      "tag": "td",
                      "attrs": {},
                      "children": [
                        "“Kayıp Ahit Sandığı’nın yerini tarif ediyor.”"
                      ]
                    },
                    {
                      "tag": "td",
                      "attrs": {},
                      "children": [
                        {
                          "tag": "span",
                          "attrs": {
                            "class": "pill red"
                          },
                          "children": [
                            "Kanıt yok"
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "td",
                      "attrs": {},
                      "children": [
                        "Metinde Ahit Sandığı’nı açıkça tanımlayan güvenilir bir ifade yok."
                      ]
                    }
