                        }
                      ]
                    },
                    {
                      "tag": "td",
                      "attrs": {},
                      "children": [
                        "Bakır kalıcılık niyetini gösterebilir; içeriğin her maddesinin gerçek olduğunu tek başına ispatlamaz."
                      ]
                    }
                  ]
                },
                "\n",
                {
                  "tag": "tr",
                  "attrs": {},
                  "children": [
                    {
                      "tag": "td",
                      "attrs": {},
                      "children": [
                        "“64 yerin hiçbiri çözülemedi.”"
