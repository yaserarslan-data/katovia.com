            {
              "tag": "b",
              "attrs": {},
              "children": [
                "Seri için durum:"
              ]
            },
            " 🟢 ",
            {
              "tag": "b",
              "attrs": {},
              "children": [
                "Büyük ölçüde açıklanmış."
              ]
            },
            {
              "tag": "br",
              "attrs": {},
              "children": []
            },
            "\n“150 bin yıllık metal boru sistemi” iddiası güvenilir biçimde doğrulanmış değil; doğal jeolojik oluşum açıklaması açık ara daha güçlü.\n"
          ]
        },
        "\n"
      ]
